---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { tg } from '../lib/tg.js';

const groups = [
  {
    title: 'Подача под ключ',
    lead: 'Документы принимаем, готовим и заносим в визовый центр мы. Вы приезжаете один раз и только на биометрию, а если действующая биометрия уже сдана, можете не приезжать вообще. Запись при этом не нужна: место в листе подачи уже есть.',
    items: [
      ['Испания, Москва', 'от 50 000 ₽', 'Подача почти каждый рабочий день, ближайшая дата обычно в пределах недели. В цену входят анкета, брони авиа и отеля под визу, все консульские и сервисные сборы, занос и возврат паспорта. Документы нужно передать за два дня до подачи, можно СДЭКом из любого города.'],
      ['Италия, Almaviva, Москва', 'от 52 000 ₽', 'Вариант для тех, кому нужна именно Италия. Подача по постоянной регистрации, биометрия обязательна. Состав тот же: анкета, брони, сборы, занос и возврат паспорта.'],
      ['Франция, Москва', 'от 68 000 ₽', 'Самое дефицитное направление: слотов в свободной продаже почти нет. Все сборы включены. Если у вас есть действующая биометрия, присутствие не требуется.'],
    ],
  },
  {
    title: 'Срочная запись',
    lead: 'Когда до поездки остается меньше месяца, а свободных дат на сайте визового центра нет.',
    items: [
      ['Франция, ловля слота ботом', 'от 15 000 ₽', 'Москва, Петербург и 16 городов регионов. Бот занимает освободившиеся и вновь выданные места круглосуточно. Оплата по факту записи, а не за попытку. Сервисный сбор визового центра, сейчас около 3 400 ₽, оплачивается отдельно.'],
      ['Испания, ловля слота ботом', 'от 15 000 ₽', 'Москва, Петербург, Екатеринбург и еще пять городов. Дальше стандартное сопровождение: документы, анкета, подготовка к подаче. Сборы визового центра отдельно.'],
      ['Предзапись на будущий месяц', 'от 12 000 ₽', 'Если поездка планируется через три месяца и позже, место бронируется заранее, до того как даты появятся в открытой продаже. Дешевле срочной записи.'],
    ],
  },
  {
    title: 'VIP-зал и Prime Time',
    lead: 'Официальные платные услуги визовых центров. Вы подаетесь сами, но без общей очереди, а иногда и без записи.',
    items: [
      ['Франция, VIP-зал', 'от 36 000 ₽', 'Прием без записи в отдельном зале. Сборы визового центра оплачиваются на месте отдельно, это около 20 000 ₽. Места в VIP-зал тоже конечны, ближайшую дату уточняем в момент обращения.'],
      ['Испания, Premium и Prime Time', 'от 19 000 ₽', 'Отдельный зал с персональным сотрудником или подача вне обычных часов работы центра. Копирование документов и помощь с анкетой входят.'],
      ['Италия, подача без записи', 'от 13 000 ₽', 'Premium-услуга Almaviva: прием в порядке живой очереди с 9 до 15 в будние дни. Доступна в Москве и семи городах регионов.'],
      ['Мобильная биометрия', 'от 25 000 ₽', 'Сотрудник визового центра приезжает к вам домой или в офис. У Испании считается за группу до 20 человек, поэтому выгодна семье или компании. По Франции бывает штучно и стоит заметно дороже, цену называем по факту наличия.'],
    ],
  },
];

const faq = [
  ['Чем занос отличается от обычной подачи?', 'При обычной подаче вы сами приходите в визовый центр в назначенное время. При подаче под ключ пакет документов готовим и передаем в визовый центр мы, а вы приезжаете только на биометрию. Записываться при этом не нужно, место уже есть.'],
  ['Это законно?', 'Да. Прием документов через агентов и доверенных лиц предусмотрен самими визовыми центрами, а VIP-зал, Prime Time и мобильная биометрия это их официальные платные услуги. Мы не делаем поддельных справок, броней с фиктивными чеками и не рисуем регистрацию: с такими пакетами отказы прилетают чаще всего.'],
  ['Почему цены плавают?', 'Стоимость места зависит от загрузки визового центра и меняется каждый месяц, иногда каждую неделю. Мы называем точную сумму в переписке до оплаты и после этого ее не двигаем.'],
  ['Визу точно дадут?', 'Нет. Ни занос, ни VIP-зал не влияют на решение консульства, они решают только задачу попасть на подачу. Гарантировать можно место и дату, но не визу.'],
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base
  title="Срочная подача и VIP-услуги — VISONA Travel"
  description="Подача документов под ключ в Испанию, Италию и Францию, срочная запись в визовый центр, VIP-зал, Prime Time и мобильная биометрия. Цены и условия."
  jsonld={jsonld}
  tgText={'Здравствуйте! Нужна срочная подача.\nСтрана: \nК какой дате нужна виза: \nЕсть ли действующая биометрия: '}
>
  <div class="wrap crumbs"><a href="/">Главная</a> / Срочная подача</div>
  <section class="hero" style="padding-top:24px">
    <div class="aurora"></div>
    <div class="wrap">
      <span class="stamp">Когда слотов нет, а лететь надо</span>
      <h1 style="margin-top:20px">Срочная подача и VIP-услуги</h1>
      <p class="note" style="margin-top:16px;font-size:17px">Свободные даты в визовых центрах Франции, Испании и Италии разбирают за минуты, а в части регионов прием идет раз в неделю. Ниже способы податься, когда обычная запись уже невозможна. Все цены указаны за одного человека и включают нашу работу.</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="offer">
        <div class="offer-eyebrow">Испания, гарантированный слот</div>
        <h2 style="margin-top:12px">Подача в любой день, хоть завтра</h2>
        <p>Самый быстрый способ получить шенген осенью. Место в листе подачи уже есть, ждать, пока дата появится в открытой продаже, не нужно. Мы готовим анкету, брони и весь пакет, заносим документы и возвращаем паспорт, вы приезжаете один раз и только на биометрию.</p>
        <span class="offer-price">от 50 000 ₽ за человека</span>
        <div class="offer-grid">
          <div class="offer-item"><b>Дата гарантирована</b><span>Подтверждаем до оплаты</span></div>
          <div class="offer-item"><b>Все сборы включены</b><span>Больше ничего доплачивать не нужно</span></div>
          <div class="offer-item"><b>Один визит</b><span>Только биометрия, 15 минут</span></div>
          <div class="offer-item"><b>Вся Россия</b><span>Документы принимаем СДЭКом</span></div>
        </div>
        <div class="cta-row"><a class="btn btn-ghost" href={tg('Здравствуйте! Хочу подачу в Испанию под ключ.\nЖелаемая дата подачи: \nСколько человек: ')} rel="noopener" data-goal="tg_spain">Забрать дату в Telegram</a></div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      {groups.map((g, gi) => (
        <div style={gi === 0 ? '' : 'margin-top:44px'}>
          <div class="eyebrow">{`0${gi + 1}`}</div>
          <h2 style="margin-top:10px">{g.title}</h2>
          <p class="note" style="margin-top:10px">{g.lead}</p>
          <div class="table-wrap">
            <table>
              <tbody>
                {g.items.map(([n, p, d]) => (
                  <tr>
                    <td><b>{n}</b><div class="muted" style="font-size:13px;font-weight:400;margin-top:4px">{d}</div></td>
                    <td style="white-space:nowrap">{p}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      <p class="note" style="margin-top:22px">Цены на срочные услуги зависят от загрузки визового центра и меняются в течение месяца, поэтому указаны от. Точную сумму и ближайшую свободную дату называем в переписке до оплаты.</p>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <div class="eyebrow">Вопросы</div>
        <h2 style="margin-top:12px;margin-bottom:12px">Что обычно спрашивают</h2>
        {faq.map(([q, a], i) => (
          <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
      <div>
        <div class="panel">
          <h3>Сначала напишите нам</h3>
          <p class="note" style="margin-top:10px">Скажите страну, даты поездки и есть ли у вас действующая биометрия. Мы ответим, успеваем ли обычной записью, и предложим срочный вариант только если он действительно нужен.</p>
          <p class="note" style="margin-top:12px"><a href="/tseny/">Обычные цены по странам</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap"><LeadForm heading="Подобрать срочный вариант" /></div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import countries from '../../data/countries.json';
export function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const others = countries.filter((x) => x.slug !== c.slug).slice(0, 4);
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Страны', item: new URL('/visa/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: `Виза ${c.case}`, item: new URL(`/visa/${c.slug}/`, Astro.site).href },
      ],
    },
    {
      '@type': 'Service',
      name: `Оформление визы ${c.case}`,
      serviceType: c.type,
      areaServed: 'RU',
      provider: { '@type': 'TravelAgency', name: 'VISONA Travel' },
      offers: { '@type': 'Offer', price: c.price, priceCurrency: 'RUB', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: c.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---
<Base
  title={`Виза ${c.case} 2026: цена, документы, сроки — VISONA Travel`}
  description={`${c.type}. Сопровождение от ${c.price.toLocaleString('ru-RU')} ₽ за человека: запись, документы, анкета и поддержка до решения консульства.`}
  jsonld={jsonld}
>
  <div class="wrap crumbs"><a href="/">Главная</a> / <a href="/visa/">Страны</a> / {c.name}</div>
  <section style="padding-top:24px">
    <div class="wrap two">
      <div>
        <span class="stamp">{c.type}</span>
        <h1 style="margin-top:16px">Виза {c.case}</h1>
        <p class="note" style="font-size:18px;margin-top:16px">{c.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#zayavka">Оставить заявку</a>
          <a class="btn btn-ghost" href="/tseny/">Все цены</a>
        </div>
      </div>
      <div class="facts">
        <div class="fact"><b>от {c.price.toLocaleString('ru-RU')} ₽</b><small>наша работа за одного человека</small></div>
        {c.facts.map(([k, v]) => (<div class="fact"><small style="margin:0">{k}</small><div style="font-weight:600;margin-top:2px">{v}</div></div>))}
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap two">
      <div>
        <div class="eyebrow">Что входит</div>
        <h2 style="margin-top:10px">Что мы делаем за {c.price.toLocaleString('ru-RU')} ₽</h2>
        <ul class="list">{c.included.map((i) => (<li>{i}</li>))}</ul>
        <p class="note" style="margin-top:18px">{c.bot}</p>
      </div>
      <div>
        <div class="eyebrow">Обязательные сборы</div>
        <h2 style="margin-top:10px">Что оплачивается отдельно</h2>
        <div class="table-wrap">
          <table>
            <tbody>
              {c.fees.map(([k, v]) => (<tr><td>{k}</td><td>{v}</td></tr>))}
            </tbody>
          </table>
        </div>
        <p class="note" style="margin-top:14px">Сборы идут консульству и визовому центру, мы на них не зарабатываем. Точные суммы называем до оплаты.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <div class="eyebrow">Вопросы</div>
        <h2 style="margin-top:10px;margin-bottom:12px">Частые вопросы по этому направлению</h2>
        {c.faq.map(([q, a], i) => (<details open={i === 0}><summary>{q}</summary><p>{a}</p></details>))}
        <details><summary>Что будет, если откажут</summary><p>Разбираем причину отказа и подаемся повторно. Наши услуги в этом случае бесплатны, заново оплачиваются только обязательные сборы.</p></details>
      </div>
      <div>
        <div class="eyebrow">Другие направления</div>
        <h2 style="margin-top:10px">Смотрят еще</h2>
        <div class="links">
          {others.map((o) => (<a class="link-row" href={`/visa/${o.slug}/`}>{o.name}<small>от {o.price.toLocaleString('ru-RU')} ₽</small></a>))}
        </div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <LeadForm heading={`Заявка на визу ${c.case}`} country={c.name} />
    </div>
  </section>
</Base>

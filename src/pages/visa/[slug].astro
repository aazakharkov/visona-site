---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import countries from '../../data/countries.json';
import { flags } from '../../data/flags.js';
export function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const flag = flags[c.slug] || null;
const others = countries.filter((x) => x.slug !== c.slug).slice(0, 4);
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Страны', item: new URL('/visa/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: `Виза ${c.case}`, item: new URL(`/visa/${c.slug}/`, Astro.site).href },
      ],
    },
    {
      '@type': 'Service',
      name: `Оформление визы ${c.case}`,
      serviceType: c.type,
      areaServed: 'RU',
      provider: { '@type': 'TravelAgency', name: 'VISONA Travel' },
      offers: { '@type': 'Offer', price: c.price, priceCurrency: 'RUB', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: c.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---
<Base
  title={`Виза ${c.case} 2026: цена, документы, сроки — VISONA Travel`}
  description={`${c.type}. Сопровождение от ${c.price.toLocaleString('ru-RU')} ₽ за человека: запись, документы, анкета и поддержка до решения консульства.`}
  jsonld={jsonld}
>
  <section class="flagwrap" style="padding-top:0">
    {flag && <div class="flagwash" set:html={flag} />}
    <div class="wrap crumbs" style="margin-bottom:24px"><a href="/">Главная</a> / <a href="/visa/">Страны</a> / {c.name}</div>
    <div class="wrap two">
      <div>
        <span class="stamp">{c.type}</span>
        <h1 style="margin-top:16px">Виза {c.case}</h1>
        <p class="note" style="font-size:18px;margin-top:16px">{c.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#zayavka">Оставить заявку</a>
          <a class="btn btn-ghost" href="/srochno/">Нужно срочно</a>
        </div>
      </div>
      <div class="facts">
        <div class="fact"><b>от {c.price.toLocaleString('ru-RU')} ₽</b><small>наша работа за одного человека</small></div>
        {c.facts.map(([k, v]) => (<div class="fact"><small style="margin:0">{k}</small><div style="font-weight:600;margin-top:2px">{v}</div></div>))}
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap two">
      <div>
        <div class="eyebrow">Что входит</div>
        <h2 style="margin-top:10px">Что вы получаете за {c.price.toLocaleString('ru-RU')} ₽</h2>
        <p class="note" style="margin-top:12px;font-size:16px">Вы не разбираетесь в требованиях консульства и не гадаете, хватит ли справок. Мы ведем подачу от первого сообщения до паспорта с визой.</p>
        <div class="feats">
          {c.included.map((i, n) => (<div class="feat"><span class="feat-n">{String(n + 1).padStart(2, '0')}</span><p>{i}</p></div>))}
        </div>
        <div class="promise">
          <div><b>Повторная подача бесплатно</b><span>если откажут после подачи с нами</span></div>
          <div><b>Ответ в течение часа</b><span>в Telegram, каждый день с 10 до 21</span></div>
          <div><b>Итоговая сумма заранее</b><span>вместе со всеми сборами, до оплаты</span></div>
        </div>
        <p class="note" style="margin-top:18px">{c.bot} <a href="/bot/">Запись ботом отдельно</a>.</p>
      </div>
      <div>
        <div class="eyebrow">Обязательные сборы</div>
        <h2 style="margin-top:10px">Что оплачивается отдельно</h2>
        <div class="table-wrap">
          <table>
            <tbody>
              {c.fees.map(([k, v]) => (<tr><td>{k}</td><td>{v}</td></tr>))}
            </tbody>
          </table>
        </div>
        <p class="note" style="margin-top:14px">Сборы идут консульству и визовому центру, мы на них не зарабатываем. Точные суммы называем до оплаты.</p>
      </div>
    </div>
  </section>

  {c.slug === 'spain' && (
    <section>
      <div class="wrap">
        <div class="offer">
          <div class="offer-eyebrow">Наша главная услуга</div>
          <h2 style="margin-top:12px">Подача в Испанию в любой день, хоть завтра</h2>
          <p>Слот гарантирован: место в листе подачи уже есть, искать свободную дату на сайте визового центра не нужно. Документы готовим и заносим мы, вы приезжаете один раз и только на биометрию. Если действующая биометрия уже сдана, приезжать не нужно вовсе, документы принимаем СДЭКом из любого города.</p>
          <span class="offer-price">от 50 000 ₽ за человека</span>
          <div class="offer-grid">
            <div class="offer-item"><b>Все сборы включены</b><span>Консульский и сервисный, доставка паспорта</span></div>
            <div class="offer-item"><b>Анкета и брони</b><span>Авиа и отель под визу готовим сами</span></div>
            <div class="offer-item"><b>Один визит</b><span>Только биометрия, 15 минут</span></div>
            <div class="offer-item"><b>Ближайшие даты</b><span>Обычно в течение недели</span></div>
          </div>
          <div class="cta-row"><a class="btn btn-ghost" href="#zayavka">Забрать дату</a></div>
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap two">
      <div>
        <div class="eyebrow">Вопросы</div>
        <h2 style="margin-top:10px;margin-bottom:12px">Частые вопросы по этому направлению</h2>
        {c.faq.map(([q, a], i) => (<details open={i === 0}><summary>{q}</summary><p>{a}</p></details>))}
        <details><summary>Что будет, если откажут</summary><p>Разбираем причину отказа и подаемся повторно. Наши услуги в этом случае бесплатны, заново оплачиваются только обязательные сборы.</p></details>
      </div>
      <div>
        <div class="eyebrow">Другие направления</div>
        <h2 style="margin-top:10px">Смотрят еще</h2>
        <div class="links">
          {others.map((o) => (<a class="link-row" href={`/visa/${o.slug}/`}>{o.name}<small>от {o.price.toLocaleString('ru-RU')} ₽</small></a>))}
        </div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <LeadForm heading={`Заявка на визу ${c.case}`} country={c.name} />
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import site from '../data/site.json';
import countries from '../data/countries.json';
import reviews from '../data/reviews.json';
import { flags } from '../data/flags.js';
import { tg } from '../lib/tg.js';
import { faq } from '../data/faq.js';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const min = Math.min(...countries.filter((c) => c.price).map((c) => c.price));
const tgMain = 'Здравствуйте! Хочу оформить визу.\nСтрана: \nДаты поездки: ';
const tgSpain = 'Здравствуйте! Хочу подачу в Испанию под ключ.\nЖелаемая дата подачи: \nСколько человек: ';
---
<Base
  title="Оформление виз в Европу, Великобританию и США | VISONA Travel"
  description={`Помогаем с визами с 2025 года: запись в визовый центр, документы, анкета и поддержка до решения консульства. Больше 150 виз у клиентов, наша работа от ${min.toLocaleString('ru-RU')} ₽ за человека.`}
  jsonld={jsonld}
>
  <section class="hero">
    <div class="aurora"></div>
    <div class="wrap two">
      <div>
        <span class="stamp">Работаем с 2025 года</span>
        <h1 style="margin-top:20px">Оформление виз в Европу, Великобританию и США</h1>
        <p class="note" style="font-size:18px;margin-top:18px">Разбираем ваш случай, записываем в визовый центр, собираем документы и ведем до решения консульства. Нас двое, мы сами много путешествуем и подаемся на визы для себя.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={tg(tgMain)} rel="noopener" data-goal="tg">Написать в Telegram</a>
          <a class="btn btn-ghost" href="/tseny/">Цены</a>
          <a class="btn btn-ghost" href="/srochno/">Нужно срочно</a>
        </div>
        <ul class="trust">
          <li>Ответ в Telegram за час</li>
          <li>Первая консультация бесплатно</li>
          <li>Повторная подача после отказа бесплатно</li>
        </ul>
      </div>
      <div class="facts">
        <div class="fact"><b>150+</b><small>виз получили наши клиенты</small></div>
        <div class="fact"><b>98%</b><small>одобрений по Франции</small></div>
        <div class="fact"><b>от {min.toLocaleString('ru-RU')} ₽</b><small>наша работа за человека, сборы отдельно</small></div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <div class="eyebrow">Страны</div>
      <h2 style="margin-top:12px">Куда помогаем получить визу</h2>
      <div class="grid grid5">
        {countries.map((c) => (
          <a class="card" href={`/visa/${c.slug}/`}>
            <span class="cflag" set:html={flags[c.slug]} />
            <div class="row"><h3>{c.name}</h3><span class="price">{c.price ? `от ${c.price.toLocaleString('ru-RU')} ₽` : 'по запросу'}</span></div>
            <p>{c.lead}</p>
            <div class="tags"><span class="tag">{c.type}</span></div>
          </a>
        ))}
      </div>
      <p class="note" style="margin-top:20px">Цена за нашу работу для одного человека. Консульский и сервисный сборы вы платите напрямую консульству и визовому центру. <a href="/tseny/">Полный прайс</a>.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Отзывы</div>
      <h2 style="margin-top:12px">Кто уже получил визу</h2>
      <p class="note" style="margin-top:12px;font-size:16px">Оригиналы отзывов со скриншотами лежат в нашем Telegram-канале, ссылка под каждой карточкой. Имена изменены.</p>
      <div class="revs">
        {reviews.map((r) => (
          <article class="rev">
            <div class="rev-head">
              <span class="cflag" set:html={flags[r.slug]} />
              <div><b>{r.name}</b><small>{r.country}, {r.date}</small></div>
            </div>
            <p>{r.text}</p>
            <a href={`${site.channel}/${r.post}`} rel="noopener" target="_blank">Отзыв в канале</a>
          </article>
        ))}
      </div>
      <div class="cta-row"><a class="btn btn-ghost" href={site.channel} rel="noopener" target="_blank">Все отзывы по тегу #отзывы</a></div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="eyebrow">Честно</div>
      <h2 style="margin-top:12px">Честно о цене и шансах</h2>
      <p class="note" style="margin-top:12px;font-size:16px">Мы небольшая команда и живем за счет рекомендаций, поэтому держим цены умеренными и не обещаем лишнего.</p>
      <div class="honest">
        <div><b>Цена известна до оплаты</b><p>Называем итоговую сумму вместе со сборами до начала работы. Доплат по ходу не бывает.</p></div>
        <div><b>Без накрутки</b><p>Наша работа стоит от {min.toLocaleString('ru-RU')} ₽, это ниже многих агентств. Срочные услуги считаем от реальной себестоимости.</p></div>
        <div><b>Не продаем лишнего</b><p>Если записаться можно вручную, бота не предлагаем. Если шансы в выбранной стране низкие, так и скажем и подскажем другую.</p></div>
        <div><b>Сборы идут напрямую</b><p>Консульский и сервисный сборы получают консульство и визовый центр. Мы на них не зарабатываем.</p></div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="offer">
        <div class="offer-eyebrow">Испания, гарантированная дата</div>
        <h2 style="margin-top:12px">Подача в любой день, хоть завтра</h2>
        <p>Свободных дат в визовых центрах почти нет, а у нас есть места в листе подачи. Документы готовим и заносим мы. Вы приезжаете один раз, на биометрию, а если она уже сдана, можно не приезжать совсем.</p>
        <span class="offer-price">от 50 000 ₽ за человека</span>
        <div class="offer-grid">
          <div class="offer-item"><b>Дата гарантирована</b><span>Подтверждаем до оплаты</span></div>
          <div class="offer-item"><b>Все сборы включены</b><span>Консульский, сервисный и доставка паспорта</span></div>
          <div class="offer-item"><b>Анкета и брони</b><span>Авиа и отель под визу готовим сами</span></div>
          <div class="offer-item"><b>Вся Россия</b><span>Документы принимаем СДЭКом</span></div>
        </div>
        <div class="cta-row">
          <a class="btn btn-ghost" href={tg(tgSpain)} rel="noopener" data-goal="tg_spain">Забрать дату в Telegram</a>
          <a class="btn btn-ghost" href="/visa/spain/" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Подробнее об Испании</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="eyebrow">Отдельные услуги</div>
      <h2 style="margin-top:12px">Срочно, VIP или только запись</h2>
      <div class="svc">
        <a class="card" href="/srochno/"><div class="row"><h3>Подача под ключ</h3><span class="price">от 50 000 ₽</span></div><p>Без записи и поиска слотов. Документы заносим мы, вы приезжаете только на биометрию. Все сборы включены.</p><div class="tags"><span class="tag">Испания, Италия, Франция</span></div></a>
        <a class="card" href="/bot/"><div class="row"><h3>Запись ботом</h3><span class="price">от 6 500 ₽</span></div><p>Только запись в визовый центр, без сопровождения. Бот круглосуточно ловит освободившиеся даты, платите по факту записи.</p><div class="tags"><span class="tag">Франция, Испания, Италия, Кипр, США</span></div></a>
        <a class="card" href="/srochno/"><div class="row"><h3>VIP-зал и Prime Time</h3><span class="price">от 13 000 ₽</span></div><p>Официальные услуги визовых центров: подача без общей очереди, вечером или без записи. Мобильная биометрия у вас дома.</p><div class="tags"><span class="tag">Франция, Испания, Италия</span></div></a>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="hard">
        <div>
          <div class="eyebrow">Сложный случай</div>
          <h2 style="margin-top:12px">Беремся за ситуации, от которых отказываются другие</h2>
          <p class="note" style="margin-top:14px;font-size:16px">С такими вопросами к нам чаще всего и приходят. Разберем вашу ситуацию и предложим рабочий вариант. Если законного способа нет, честно скажем об этом на бесплатной консультации.</p>
          <div class="cta-row"><a class="btn btn-primary" href={tg('Здравствуйте! У меня непростая ситуация с визой.\nСтрана: \nЧто случилось: ')} rel="noopener" data-goal="tg_hard">Описать ситуацию</a></div>
        </div>
        <div>
          <div class="eyebrow">С чем приходят</div>
          <ul class="hard-list">
            <li>Раньше был отказ</li>
            <li>Нет официальной работы или справки</li>
            <li>До поездки меньше месяца</li>
            <li>В вашем городе нет записи</li>
            <li>Прописка в одном регионе, живете в другом</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <div class="eyebrow">Как работаем</div>
      <h2 style="margin-top:12px">Четыре шага до паспорта с визой</h2>
      <div class="steps">
        <div class="step"><h3>Разбираем ситуацию</h3><p>Вы пишете, куда и когда едете. Мы говорим, успеваете ли, в какую страну подаваться выгоднее и сколько это стоит вместе со сборами.</p></div>
        <div class="step"><h3>Записываем</h3><p>Где можно, записываем вручную. Где свободных дат нет, подключаем бота. Дату согласуем с вами заранее.</p></div>
        <div class="step"><h3>Собираем пакет</h3><p>Маршрутный лист, сопроводительное письмо, брони, справки, анкета. Проверяем каждый документ и объясняем, что хочет увидеть консул.</p></div>
        <div class="step"><h3>Ведем до решения</h3><p>Готовим к подаче, отвечаем в день визита и следим за статусом. Если откажут, повторная подача с нами бесплатна.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <div class="eyebrow">Вопросы</div>
        <h2 style="margin-top:12px;margin-bottom:12px">Что обычно спрашивают</h2>
        {faq.map(([q, a], i) => (
          <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
      <div style="position:sticky;top:90px">
        <div class="panel">
          <h3>Кто с вами работает</h3>
          <p class="note" style="margin-top:10px">Александр ведет визы и сложные случаи, был в 60 странах. Виолетта ведет блог о путешествиях, общается с клиентами и помогает подготовиться к поездке.</p>
          <p class="note" style="margin-top:12px"><a href="/o-nas/">Подробнее о нас</a></p>
        </div>
        <a class="card" href="/gaydy/" style="margin-top:16px"><h3>Бесплатные гайды</h3><p>Как записаться, что писать в анкете, какие нужны документы. Для тех, кто хочет разобраться сам.</p><div class="tags"><span class="tag">Смотреть гайды</span></div></a>
        <div class="cta-strip" style="margin-top:16px">
          <div><h3>Не нашли свой вопрос?</h3><p>Напишите в Telegram, ответим в течение часа.</p></div>
          <a class="btn btn-primary" href={tg(tgMain)} rel="noopener" data-goal="tg_faq">Спросить</a>
        </div>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <LeadForm />
    </div>
  </section>
</Base>


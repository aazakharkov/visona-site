---
import { tg } from '../lib/tg.js';
// Заявка через Telegram. Серверной формы пока нет, поэтому показываем одну понятную кнопку вместо полей.
const { heading = 'Расскажите, куда собираетесь', country = '' } = Astro.props;
const text = `Здравствуйте! Хочу оформить визу.\nСтрана: ${country}\nДаты поездки: \nГород подачи: `;
---
<div class="panel ctacard" id="zayavka">
  <div>
    <div class="eyebrow">Заявка</div>
    <h2 style="margin-top:10px">{heading}</h2>
    <p class="note" style="margin-top:12px">Напишите страну, даты поездки и город подачи. Этого хватит, чтобы назвать срок и точную сумму со всеми сборами. Если поездка горит, так и скажите.</p>
    <ul class="trust" style="margin-top:14px">
      <li>Ответ в течение часа, с 10 до 21</li>
      <li>Первая консультация бесплатно</li>
      <li>Итоговая сумма до оплаты</li>
    </ul>
  </div>
  <div class="ctacard-go">
    <a class="btn btn-primary btn-lg" href={tg(text)} rel="noopener" data-goal="tg_form">Написать в Telegram</a>
    <small class="muted">Откроется чат с готовым сообщением, останется дописать детали.</small>
  </div>
</div>

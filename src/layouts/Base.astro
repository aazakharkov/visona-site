---
import '../styles/global.css';
import site from '../data/site.json';
import { tg, TG_DEFAULT } from '../lib/tg.js';
const { title, description, path = Astro.url.pathname, jsonld = null, noindex = false, tgText = TG_DEFAULT } = Astro.props;
const tgHref = tg(tgText);
const canonical = new URL(path, Astro.site).href;
const year = new Date().getFullYear();
const nav = [
  ['/visa/', 'Страны'],
  ['/srochno/', 'Срочно'],
  ['/bot/', 'Бот'],
  ['/tseny/', 'Цены'],
  ['/gaydy/', 'Гайды'],
  ['/o-nas/', 'О нас'],
  ['/kontakty/', 'Контакты'],
];
const org = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  name: site.name,
  url: Astro.site?.href,
  email: site.email,
  areaServed: "RU",
  foundingDate: "2025",
  founder: [{ "@type": "Person", name: "Александр Захарков" }, { "@type": "Person", name: "Виолетта Осипенкова" }],
  sameAs: [site.telegram, site.instagram, site.channel],
  openingHours: "Mo-Su 10:00-21:00",
};
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="ru_RU" />
<meta name="theme-color" content="#F5F6F8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0B0F13" media="(prefers-color-scheme: dark)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=Unbounded:wght@500;600&display=swap" />
<script is:inline>
(function () {
  try {
    var t = localStorage.getItem('visona-theme');
    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
})();
</script>
<script type="application/ld+json" set:html={JSON.stringify(org)} />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<!-- Яндекс Метрика: вставьте счетчик сюда после запуска сайта. Скрипт должен подключаться только после согласия на cookie. -->
</head>
<body>
<header class="topbar" id="topbar">
  <div class="wrap topbar-in">
    <a class="brand" href="/">VISONA <span>travel</span></a>
    <nav class="nav">
      {nav.map(([href, label]) => (
        <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <button class="theme-toggle navburger" id="menu-toggle" type="button" aria-label="Меню" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Переключить тему" title="Светлая или темная тема">
      <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
    </button>
    <a class="btn btn-primary btn-sm" href={tgHref} rel="noopener" data-goal="tg">Написать в Telegram</a>
  </div>
  <div class="menu" id="menu">
    {nav.map(([href, label]) => (<a href={href}>{label}</a>))}
    <a href={tgHref} rel="noopener" data-goal="tg">Написать в Telegram</a>
  </div>
</header>
<main>
  <slot />
</main>
<a class="tgbar" href={tgHref} rel="noopener" data-goal="tg"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M21.4 4.2 2.9 11.3c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.1.9.8.9.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.5-1.9-1.5-1.4zM8 14.1l10.4-6.6c.5-.3.9-.1.6.2l-8.9 8-.3 3.8L8 14.1z"/></svg><span>Написать в Telegram<small>ответим в течение часа</small></span></a>
<footer>
  <div class="wrap foot">
    <div>
      <strong>{site.name}</strong>
      <p style="margin-top:8px">Помощь в подготовке документов на визу. Мы не визовый центр и не консульство и на решение по визе не влияем.</p>
      <p style="margin-top:8px">{site.legalName}<br />{site.inn}<br />{site.ogrn}</p>
    </div>
    <div>
      <a href="/visa/">Страны и визы</a>
      <a href="/srochno/">Срочная подача и VIP</a>
      <a href="/bot/">Запись ботом</a>
      <a href="/tseny/">Цены</a>
      <a href="/gaydy/">Бесплатные гайды</a>
      <a href="/o-nas/">О нас</a>
      <a href="/kontakty/">Контакты</a>
    </div>
    <div>
      <a href={site.telegram} rel="noopener">Telegram {site.telegramHandle}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href="/politika/">Политика конфиденциальности</a>
    </div>
  </div>
  <div class="wrap" style="margin-top:18px">© {year} {site.name}</div>
</footer>
<div class="cookie" id="cookie" hidden>
  <p>Сайт использует файлы cookie и сервисы веб-аналитики. Подробности в <a href="/politika/">политике конфиденциальности</a>.</p>
  <button class="btn btn-ghost btn-sm" id="cookie-no" type="button">Только необходимые</button>
  <button class="btn btn-primary btn-sm" id="cookie-yes" type="button">Принять</button>
</div>
<script is:inline>
(function () {
  var btn = document.getElementById('theme-toggle');
  if (btn) btn.addEventListener('click', function () {
    var root = document.documentElement;
    var current = root.getAttribute('data-theme');
    if (!current) current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    var next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('visona-theme', next); } catch (e) {}
  });
})();
(function () {
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[data-goal]');
    if (a && typeof window.visonaGoal === 'function') window.visonaGoal(a.getAttribute('data-goal'), location.pathname);
  });
})();
(function () {
  var toggle = document.getElementById('menu-toggle');
  var menu = document.getElementById('menu');
  if (!toggle || !menu) return;
  toggle.addEventListener('click', function () {
    var open = menu.getAttribute('data-open') === '1';
    menu.setAttribute('data-open', open ? '0' : '1');
    toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
  });
  document.addEventListener('click', function (e) {
    if (menu.getAttribute('data-open') !== '1') return;
    if (menu.contains(e.target) || toggle.contains(e.target)) return;
    menu.setAttribute('data-open', '0');
    toggle.setAttribute('aria-expanded', 'false');
  });
})();
(function () {
  var bar = document.getElementById('topbar');
  if (!bar) return;
  var onScroll = function () {
    if (window.scrollY > 8) bar.classList.add('is-stuck');
    else bar.classList.remove('is-stuck');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
})();
(function () {
  var box = document.getElementById('cookie');
  if (!box) return;
  var stored = null;
  try { stored = localStorage.getItem('visona-cookie'); } catch (e) {}
  if (!stored) box.hidden = false;
  function decide(value) {
    try { localStorage.setItem('visona-cookie', value); } catch (e) {}
    box.hidden = true;
    if (value === 'all' && typeof window.visonaEnableAnalytics === 'function') window.visonaEnableAnalytics();
  }
  document.getElementById('cookie-yes').addEventListener('click', function () { decide('all'); });
  document.getElementById('cookie-no').addEventListener('click', function () { decide('necessary'); });
  if (stored === 'all' && typeof window.visonaEnableAnalytics === 'function') window.visonaEnableAnalytics();
})();
</script>
</body>
</html>
